# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ─── Database ───────────────────────────────────────────────────────────────
# MongoDB connection string. Leave empty in development to use the bundled
# embedded MongoDB (real engine, persisted in backend/.data/db).
# Example Atlas: mongodb+srv://user:password@cluster.mongodb.net/aurelis
MONGODB_URI=
# Development-only embedded database. Set to false when MONGODB_URI is provided.
ENABLE_MEMORY_DB=true
AUTO_SEED=true

# ─── Authentication ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=aurelis_token

# ─── Commerce ───────────────────────────────────────────────────────────────
CURRENCY=usd
TAX_RATE=0.08
SHIPPING_FEE=12
FREE_SHIPPING_THRESHOLD=150

# ─── Seed accounts (change in production) ───────────────────────────────────
ADMIN_EMAIL=admin@aurelis.com
ADMIN_PASSWORD=Admin@12345
DEMO_EMAIL=demo@aurelis.com
DEMO_PASSWORD=Demo@12345

# ─── Stripe (test mode recommended) ────────────────────────────────────────
# Leave both empty to use the built-in sandbox payment processor (test mode).
# Use sk_test_… and pk_test_… keys for Stripe test mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Cloudinary (optional) ──────────────────────────────────────────────────
# When empty, product images are stored in backend/uploads and served locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email / password reset (optional) ─────────────────────────────────────
# When SMTP is empty, reset links are logged to the server console and returned
# in the API response in development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AURELIS <no-reply@aurelis.example>
